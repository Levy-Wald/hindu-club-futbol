{
  "name": "hindu-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "audit:schema": "npx tsx scripts/audit-schema-vs-code.ts",
    "validate:manifests": "npx tsx scripts/validate-module-manifests.ts",
    "validate:all": "npm run validate:manifests && npm run test:e2e && npm run build",
    "validate:strict": "npm run lint && npm run validate:manifests && npm run audit:schema && npm run test:e2e && npm run build",
    "test:unit": "vitest run tests/unit/",
    "test:e2e": "node --env-file=.env.local -e \"require('child_process').execSync('npx playwright test', {stdio:'inherit'})\"",
    "test:e2e:ui": "node --env-file=.env.local -e \"require('child_process').execSync('npx playwright test --ui', {stdio:'inherit'})\""
  },
