    "googleapis": "^172.0.0",
    "html-to-image": "^1.11.13",
    "isomorphic-dompurify": "^3.13.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
