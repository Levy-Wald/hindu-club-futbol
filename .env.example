RESEND_FROM=ClubCore <onboarding@resend.dev>
PAYMENTS_MODE=mock                      # mock | mercadopago (default: mock)
MERCADOPAGO_ACCESS_TOKEN=               # cobro online real (F5)
MESSAGING_MODE=mock                     # mock | whatsapp (default: mock)
WHATSAPP_TOKEN=                         # WhatsApp Business Cloud API (F5)
WHATSAPP_PHONE_ID=                      # phone_number_id de WhatsApp Business (F5)
CALENDAR_MODE=mock                      # mock | google | outlook | caldav (default: mock)
GOOGLE_CLIENT_ID=                       # OAuth Google Calendar (F5)
GOOGLE_CLIENT_SECRET=                   # OAuth Google Calendar (F5)
